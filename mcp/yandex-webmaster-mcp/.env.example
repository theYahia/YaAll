# Yandex Webmaster OAuth token with the webmaster:api scope (required).
YANDEX_WEBMASTER_TOKEN=

# Numeric Webmaster user ID (optional). Auto-detected via GET /user/ when unset.
YANDEX_WEBMASTER_USER_ID=

# HTTP mode (only used with `--http`).
PORT=3100
# Comma-separated allowed Host headers; "*" disables DNS-rebinding protection.
MCP_ALLOWED_HOSTS=
# If set, POST /mcp requires `Authorization: Bearer <token>`.
MCP_HTTP_AUTH_TOKEN=
